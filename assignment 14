# 12. Using else block (runs only if no exception occurs)
print("\n----- 12. Using else block -----")

try:
    x = 10
    y = 2
    result = x / y
except ZeroDivisionError:
    print("Error: Cannot divide by zero")
else:
    print("No exception occurred. Result:", result)


# 13. Logging errors instead of printing
print("\n----- 13. Logging errors using logging module -----")

import logging

logging.basicConfig(
    filename="error_log.txt",
    level=logging.ERROR,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

try:
    value = 10 / 0
except ZeroDivisionError as e:
    logging.error("Division error occurred: %s", e)
    print("Error occurred and has been logged to error_log.txt")


# 14. Input validation system - keeps asking until valid data is entered
print("\n----- 14. Input validation system -----")

def get_valid_age():
    while True:
        try:
            age = int(input("Enter your age: "))
            if age <= 0:
                print("Age must be a positive number. Try again.")
                continue
            return age
        except ValueError:
            print("Invalid input. Please enter a whole number.")

