#19. Sort a list without using sort() or sorted()
def bubble_sort(lst):
    n = len(lst)
    sorted_list = lst.copy()
    for i in range(n):
        for j in range(0, n - i - 1):
            if sorted_list[j] > sorted_list[j + 1]:
                sorted_list[j], sorted_list[j + 1] = sorted_list[j + 1], sorted_list[j]
    return sorted_list

unsorted_list = [5, 2, 9, 1, 7]
print("\nUnsorted:", unsorted_list)
print("Sorted (bubble sort):", bubble_sort(unsorted_list))


