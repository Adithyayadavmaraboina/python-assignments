#4.Local vs Global Variables 
num = 15   # global variable
def show():
    num = 10   # local variable, same name as global
    print("local num =", num)
show()
print("global num =", num)
def change():
    global num
    num = 20
    print("inside function =", num)
change()
print("after change =", num)

