#13. Count digits in a number using a loop
num = int(input("\nEnter a number to count digits: "))
count = 0
temp = num

if temp == 0:
    count = 1
else:
    temp = abs(temp)
    while temp > 0:
        temp //= 10
        count += 1

print("Number of digits in", num, "is", count)
