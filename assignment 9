# Assignment 9 - Abstract Classes in Python

from abc import ABC, abstractmethod


# 1. Abstract class with abstract and non-abstract methods

class Vehicle(ABC):
    @abstractmethod
    def start_engine(self):
        pass   # no implementation here, subclasses must implement this

    def general_info(self):
        print("This is a vehicle that can be driven on roads")


# 2. Create a child class that implements the abstract method

class Car(Vehicle):
    def start_engine(self):
        print("Car engine started with a key/button")


print("----- 3. Access non-abstract method via child object -----")
car1 = Car()
car1.general_info()   # inherited from parent class Vehicle


print("\n----- 4. Call abstract method implementation -----")
car1.start_engine()   # calls the Car's own implementation


print("\n----- 5. Attempt to instantiate abstract class directly -----")
try:
    vehicle_obj = Vehicle()
except TypeError as e:
    print("Error:", e)
    print("This happens because Vehicle has an unimplemented abstract method,")
    print("so Python does not allow creating an object of it directly.")


print("\n----- 6. Multiple abstract methods -----")

class Animal(ABC):
    @abstractmethod
    def make_sound(self):
        pass

    @abstractmethod
    def move(self):
        pass

    def eat(self):
        print("This animal is eating")


class Dog(Animal):
    def make_sound(self):
        print("Dog says: Woof Woof")

    def move(self):
        print("Dog runs on four legs")


dog1 = Dog()
dog1.make_sound()
dog1.move()
dog1.eat()


print("\n----- 7. Real-world example: Shape -> Circle, Rectangle -----")

class Shape(ABC):
    @abstractmethod
    def area(self):
        pass

    def display(self):
        print("This shape has an area of:", self.area())


class Circle(Shape):
    def __init__(self, radius):
        self.radius = radius

    def area(self):
        return 3.14159 * self.radius * self.radius


class Rectangle(Shape):
    def __init__(self, length, width):
        self.length = length
        self.width = width

    def area(self):
        return self.length * self.width


circle1 = Circle(5)
rectangle1 = Rectangle(10, 4)

print("Circle:")
circle1.display()

print("\nRectangle:")
rectangle1.display()


print("\n----- 8. Partial implementation (missing one abstract method) -----")

class Bird(Animal):
    def make_sound(self):
        print("Bird says: Tweet Tweet")
    # move() is NOT implemented here on purpose

try:
    bird1 = Bird()
except TypeError as e:
    print("Error:", e)
    print("This happens because Bird did not implement all abstract methods")
    print("from its parent class Animal (it's missing 'move'), so Python")
    print("still treats Bird as abstract and won't allow creating an object of it.")
